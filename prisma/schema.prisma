// Ripple Chat — Prisma schema (PostgreSQL / Neon)
// UUID primary keys, normalized relations, indexes on all foreign keys and
// frequently filtered columns.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============================
// Enums
// ==============================

enum UserRole {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ONLINE
  IDLE
  DND
  OFFLINE
}

enum RoomVisibility {
  PUBLIC
  PRIVATE
}

enum RoomMemberRole {
  OWNER
  MODERATOR
  MEMBER
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

enum NotificationKind {
  MENTION
  MESSAGE
  REPLY
  INVITE
  ROOM
  SYSTEM
  REACTION
  FRIEND
}

enum OTPPurpose {
  EMAIL_VERIFICATION
}

enum DeviceType {
  DESKTOP
  MOBILE
  TABLET
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum ReportStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum AuditAction {
  USER_CREATED
  USER_SUSPENDED
  USER_UNSUSPENDED
  USER_DELETED
  USER_ROLE_CHANGED
  ROOM_CREATED
  ROOM_DELETED
  ROOM_UPDATED
  MESSAGE_DELETED
  REPORT_CREATED
  REPORT_RESOLVED
  REPORT_DISMISSED
  INVITE_SENT
  INVITE_ACCEPTED
  INVITE_DECLINED
  SYSTEM_CONFIG
}

// ==============================
// User
// ==============================

model User {
  id             String     @id @default(uuid())
  name           String
  username       String     @unique
  email          String     @unique
  passwordHash   String
  avatarUrl      String?
  avatarPublicId String?
  bannerUrl      String?
  bannerPublicId String?
  bio            String?    @db.VarChar(280)
  phone          String?
  socials        Json?
  role           UserRole   @default(USER)
  status         UserStatus @default(OFFLINE)
  isVerified     Boolean    @default(false)
  lastSeen       DateTime   @default(now())
  lastLoginAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  ownedRooms         Room[]            @relation("RoomOwner")
  roomMemberships    RoomMember[]
  messages           Message[]
  reactions          MessageReaction[]
  notifications      Notification[]   @relation("NotificationRecipient")
  actorNotifications Notification[]   @relation("NotificationActor")
  refreshTokens      RefreshToken[]
  otpVerifications   OTPVerification[]
  passwordResets     PasswordReset[]
  sessions           Session[]
  devices            Device[]
  auditLogs          AuditLog[]
  sentInvites        RoomInvite[]       @relation("Inviter")
  receivedInvites    RoomInvite[]       @relation("Invitee")
  reports            Report[]           @relation("Reporter")
  reviewedReports    Report[]           @relation("Reviewer")

  @@index([email])
  @@index([username])
  @@map("users")
}

// ==============================
// Room / RoomMember
// ==============================

model Room {
  id           String         @id @default(uuid())
  name         String
  icon         String?
  description  String?
  category     String?        @default("general")
  visibility   RoomVisibility @default(PUBLIC)
  isDirect     Boolean        @default(false)
  passwordHash String?
  inviteCode   String         @unique @default(uuid())
  ownerId      String
  owner        User           @relation("RoomOwner", fields: [ownerId], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  members  RoomMember[]
  messages Message[]
  invites  RoomInvite[]

  @@index([ownerId])
  @@index([visibility])
  @@index([category])
  @@index([isDirect])
  @@map("rooms")
}

model RoomMember {
  id                String         @id @default(uuid())
  roomId            String
  room              Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role              RoomMemberRole @default(MEMBER)
  pinned            Boolean        @default(false)
  recentlyJoined    Boolean        @default(true)
  unreadCount       Int            @default(0)
  lastReadMessageId String?
  joinedAt          DateTime       @default(now())

  @@unique([roomId, userId])
  @@index([userId])
  @@index([roomId])
  @@map("room_members")
}

model RoomInvite {
  id         String       @id @default(uuid())
  roomId     String
  room       Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  inviterId  String
  inviter    User         @relation("Inviter", fields: [inviterId], references: [id])
  inviteeId  String
  invitee    User         @relation("Invitee", fields: [inviteeId], references: [id])
  status     InviteStatus @default(PENDING)
  message    String?
  respondedAt DateTime?
  createdAt  DateTime     @default(now())

  @@unique([roomId, inviteeId])
  @@index([inviteeId, status])
  @@index([inviterId])
  @@map("room_invites")
}

// ==============================
// Message / Reaction / Attachment
// ==============================

model Message {
  id          String      @id @default(uuid())
  roomId      String
  room        Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  authorId    String
  author      User        @relation(fields: [authorId], references: [id])
  text        String?
  type        MessageType @default(TEXT)
  replyToId   String?
  replyTo     Message?    @relation("MessageReply", fields: [replyToId], references: [id])
  replies     Message[]   @relation("MessageReply")
  pinned      Boolean     @default(false)
  edited      Boolean     @default(false)
  editedAt    DateTime?
  deliveredAt DateTime?
  seenAt      DateTime?
  mentions    String[]    @default([])
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())

  attachments   Attachment[]
  reactions     MessageReaction[]
  notifications Notification[]

  @@index([roomId, createdAt])
  @@index([authorId])
  @@index([replyToId])
  @@map("messages")
}

model MessageReaction {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

model Attachment {
  id        String   @id @default(uuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  url       String
  publicId  String
  fileName  String
  fileType  String
  fileSize  Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  @@index([messageId])
  @@map("attachments")
}

// ==============================
// Notification
// ==============================

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  title     String
  body      String?
  read      Boolean          @default(false)
  actorId   String?
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id])
  roomId    String?
  messageId String?
  message   Message?         @relation(fields: [messageId], references: [id])
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ==============================
// Reports (user/message moderation)
// ==============================

model Report {
  id          String       @id @default(uuid())
  reporterId  String
  reporter    User         @relation("Reporter", fields: [reporterId], references: [id])
  targetType  String       // "user", "message", "room"
  targetId    String
  reason      String
  description String?
  status      ReportStatus @default(OPEN)
  reviewerId  String?
  reviewer    User?        @relation("Reviewer", fields: [reviewerId], references: [id])
  resolution  String?
  resolvedAt  DateTime?
  createdAt   DateTime     @default(now())

  @@index([status])
  @@index([targetType, targetId])
  @@index([reporterId])
  @@index([reviewerId])
  @@map("reports")
}

// ==============================
// Auth-related: RefreshToken, OTP, PasswordReset
// ==============================

model RefreshToken {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash           String   @unique
  family              String
  revoked             Boolean  @default(false)
  replacedByTokenHash String?
  userAgent           String?
  ip                  String?
  expiresAt           DateTime
  createdAt           DateTime @default(now())

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

model OTPVerification {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  purpose    OTPPurpose @default(EMAIL_VERIFICATION)
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([userId, purpose])
  @@map("otp_verifications")
}

model PasswordReset {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("password_resets")
}

// ==============================
// Session / Device (presence + "connected devices")
// ==============================

model Session {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId      String?
  device        Device?   @relation(fields: [deviceId], references: [id])
  refreshFamily String?
  ip            String?
  userAgent     String?
  location      String?
  current       Boolean   @default(true)
  lastActiveAt  DateTime  @default(now())
  createdAt     DateTime  @default(now())
  revokedAt     DateTime?

  @@index([userId])
  @@map("sessions")
}

model Device {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       DeviceType @default(DESKTOP)
  name       String?
  location   String?
  lastSeenAt DateTime   @default(now())
  createdAt  DateTime   @default(now())

  sessions Session[]

  @@index([userId])
  @@map("devices")
}

// ==============================
// Audit Log
// ==============================

model AuditLog {
  id        String      @id @default(uuid())
  action    AuditAction
  actorId   String?
  actor     User?       @relation(fields: [actorId], references: [id])
  targetId  String?
  targetType String?    // "user", "room", "message", "report"
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime    @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
